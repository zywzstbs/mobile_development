# 复制为 .env 后填写；本文件不包含真实秘密。
# 数据库
DB_URL=jdbc:postgresql://localhost:5432/gulupai
DB_USERNAME=gulupai
DB_PASSWORD=
DB_POOL_SIZE=10

# 服务
SERVER_PORT=8080
APP_ENV=local
APP_VERSION=0.1.0-P16

# 幂等回放结果加密密钥：32 字节 Base64；生产必须独立随机生成。
# 生成示例：openssl rand -base64 32
# 本地/测试/演示 profile 已有开发默认值，因此默认注释掉。
# IDEMPOTENCY_ENCRYPTION_KEY=
# IDEMPOTENCY_KEY_ID=local-dev-v1

# 仅演示/测试使用：冻结时钟起始时刻（UTC，可留空）
# APP_FIXED_INSTANT=2026-01-01T00:00:00Z
