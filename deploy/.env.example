# 复制为 deploy/.env 后填写。不要把填好的文件提交到仓库。
POSTGRES_PASSWORD=
IDEMPOTENCY_ENCRYPTION_KEY=
API_DOMAIN=localhost
# 浏览器/App 能访问到的 origin，不含 /api/v1。文件上传和下载地址按它拼接。
APP_FILES_PUBLIC_BASE_URL=http://localhost
# 发布时可指定可追踪版本；不影响数据库迁移版本。
APP_VERSION=0.1.0-P16
# 注册默认关闭。启用时需配置独立指纹密钥，并通过受控 CLI 开放指定学校。
REGISTRATION_ENABLED=false
REGISTRATION_TEACHER_ENABLED=false
REGISTRATION_FINGERPRINT_KEY=
REGISTRATION_KEY_ID=registration-v1
